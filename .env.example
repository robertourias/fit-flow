# Turbo Remote Cache (opcional — habilitar para builds incrementais em CI)
TURBO_TOKEN=<seu-token-turbo-remote-cache>
TURBO_TEAM=<seu-team-slug>

# ─── Banco de dados ────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fitflow
POSTGRES_PORT=5432

# URL de conexão Prisma — usada em packages/db (prisma migrate + prisma generate)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fitflow?schema=public"

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ─── API (NestJS) ──────────────────────────────────────────────────────────────
NODE_ENV=development
# Migrations: defina 1 para pular em réplicas de leitura
SKIP_MIGRATIONS=0

# ─── E-mail (BullMQ workers) ───────────────────────────────────────────────────
# Em dev usa maildev (profile: tools); em prod configura com seu provedor SMTP
MAIL_HOST=maildev
MAIL_PORT=1025
MAIL_FROM=noreply@fitflow.local

# ─── Auth (NextAuth v5) ────────────────────────────────────────────────────────
# Gerar com: openssl rand -base64 32
AUTH_SECRET=<gerar-com-openssl-rand-base64-32>
# AUTH_URL é auto-detectada em dev; definir em produção
# AUTH_URL=https://fitflow.com

# ─── Web (Next.js) ─────────────────────────────────────────────────────────────
# URL da API acessível pelo browser (não pela rede interna Docker)
NEXT_PUBLIC_API_URL=http://localhost:3001

# URL da API para chamadas server-side (proxy BFF, Server Components) dentro do
# container web. Docker Compose já define o default http://api:3001.
# API_INTERNAL_URL=http://api:3001

# ─── Portas dos serviços Docker (sobrescreva se houver conflito no host) ────────
WEB_PORT=3000
API_PORT=3001
