# ─────────────────────────────────────────────
# apps/web — variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores.
# Variáveis NEXT_PUBLIC_* são expostas ao browser.
# ─────────────────────────────────────────────

# URL da API NestJS acessível pelo browser (host) — usada no bundle e por apiFetch
# no cliente. Sempre http://localhost:3001, em Docker ou fora dele.
NEXT_PUBLIC_API_URL=http://localhost:3001

# URL da API usada por código server-side (proxy BFF, Server Components).
# Fora do Docker: omitir (cai no fallback NEXT_PUBLIC_API_URL=http://localhost:3001).
# Dentro do Docker Compose: http://api:3001 (hostname interno, não localhost).
# API_INTERNAL_URL=http://api:3001

# Sentry (error tracking) — opcional. Sem esta variável, o SDK não inicializa
# (no-op total, sem chamadas de rede). Defina apenas em produção/staging com um DSN real.
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>

# Token de auth do Sentry (opcional) — habilita upload de source maps no build.
# Sem ele, o upload é pulado automaticamente (ver next.config.ts).
# SENTRY_AUTH_TOKEN=<sentry-auth-token>
